# ==============================================================================
# SecureDB Configuration (.env.example)
# Web-Based Automated Database Backup & Security Management System
# ==============================================================================

# [SECURITY CRITICAL] 256-bit Hexadecimal Master Key
# Must be exactly 64 hex characters (32 bytes).
# In production, derive from KMS, HSM, or HashiCorp Vault.
# Generate each value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECUREDB_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS
# Application Database URL
# Default SQLite fallback for instant zero-dependency local evaluation:
DATABASE_URL=sqlite:///./securedb.db
# Or PostgreSQL for Docker / production:
# DATABASE_URL=postgresql://securedb_user:securedb_pass@postgres:5432/securedb

# JWT Secret & Expiration
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Storage Paths
SECUREDB_STORAGE_DIR=./storage/backups
SECUREDB_TEMP_DIR=./storage/temp

# AES-256-GCM Streaming Chunk Size (4 MB = 4194304 bytes)
SECUREDB_CHUNK_SIZE=4194304
